# Copy this file to .env and change the values if needed.
# Never commit the real .env file.

# Port the API server listens on. Leave it out on Render: Render sets PORT itself.
PORT=5000

# "development" on your computer. On Render set NODE_ENV=production
# (if it is missing, the server also behaves as production).
NODE_ENV=development

# Address of the website, used by CORS to allow requests from it (no "/" at the end).
# Local: http://localhost:5173   Production: your Vercel address, e.g. https://your-site.vercel.app
# Required in production: the server will not start without it.
FRONTEND_URL=http://localhost:5173

# Supabase (Project Settings -> API Keys)
SUPABASE_URL=https://your-project-id.supabase.co
# SECRET: full database access. Only ever put this in backend/.env, never in the frontend or Git.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Cloudinary (Console -> Dashboard -> "Product Environment Credentials")
# Photos and videos are stored in Cloudinary; the database only keeps their URLs and ids.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
# SECRET: never put this in the frontend or in Git.
CLOUDINARY_API_SECRET=your-api-secret
