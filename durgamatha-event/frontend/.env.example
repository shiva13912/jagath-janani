# Copy this file to .env and change the values if needed.
# Only variables starting with VITE_ are available in the browser code.
# Never put secrets here: everything in the frontend is visible to users.

# URL of the backend API
VITE_API_URL=http://localhost:5000

# Supabase (Project Settings -> API Keys). Both values are safe to be public.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
